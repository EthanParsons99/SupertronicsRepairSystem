@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "My Quote Requests";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6 fw-bold mb-2 text-primary">
                <i class="bi bi-file-text me-2"></i>My Quote Requests
            </h1>
            <p class="text-muted">Track the status of your quote requests</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-md">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                <h3 class="text-muted">No Quote Requests Yet</h3>
                <p class="text-muted mb-4">You haven't submitted any quote requests. Request a quote to get started!</p>
                <a asp-controller="Customer" asp-action="CustomerGetQuote" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Request a Quote
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var quote in Model)
            {
                var quoteId = quote.GetValueOrDefault("Id")?.ToString() ?? "";
                var deviceType = quote.GetValueOrDefault("DeviceType")?.ToString() ?? "";
                var brand = quote.GetValueOrDefault("Brand")?.ToString() ?? "";
                var model = quote.GetValueOrDefault("Model")?.ToString() ?? "";
                var serialNumber = quote.GetValueOrDefault("SerialNumber")?.ToString() ?? "";
                var problemDesc = quote.GetValueOrDefault("ProblemDescription")?.ToString() ?? "";
                var status = quote.GetValueOrDefault("Status")?.ToString() ?? "Pending";
                var repairJobId = quote.GetValueOrDefault("RepairJobId")?.ToString() ?? "";

                DateTime? createdAt = null;
                if (quote.ContainsKey("CreatedAt") && quote["CreatedAt"] is Google.Cloud.Firestore.Timestamp timestamp)
                {
                    createdAt = timestamp.ToDateTime();
                }

                DateTime? updatedAt = null;
                if (quote.ContainsKey("LastUpdated") && quote["LastUpdated"] is Google.Cloud.Firestore.Timestamp updateTimestamp)
                {
                    updatedAt = updateTimestamp.ToDateTime();
                }

                var statusClass = status.ToLower() switch
                {
                    "pending" => "warning", // Uses .bg-warning from your CSS
                    "approved" => "success", // Uses .bg-success from your CSS
                    "rejected" => "danger", // Uses .bg-danger from your CSS
                    _ => "secondary"
                };

                var statusIcon = status.ToLower() switch
                {
                    "pending" => "clock-history",
                    "approved" => "check-circle",
                    "rejected" => "x-circle",
                    _ => "question-circle"
                };

                var deviceInfo = !string.IsNullOrEmpty(brand) && !string.IsNullOrEmpty(model)
                    ? $"{brand} {model}"
                    : deviceType;

                <div class="col-lg-6">
                    <div class="card shadow-md h-100">
                        <div class="card-header"> 
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-device-hdd me-1"></i>@deviceInfo
                                </h5>
                                <span class="badge bg-@statusClass">
                                    <i class="bi bi-@statusIcon me-1"></i>@status
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6 class="text-primary mb-2">
                                    <i class="bi bi-info-circle me-1"></i>Device Details
                                </h6>
                                @if (!string.IsNullOrEmpty(model))
                                {
                                    <p class="mb-1"><strong>Model:</strong> </p>
                                }
                                @if (!string.IsNullOrEmpty(serialNumber))
                                {
                                    <p class="mb-1"><strong>Serial Number:</strong> @serialNumber</p>
                                }
                            </div>

                            <div class="mb-3">
                                <h6 class="text-primary mb-2">
                                    <i class="bi bi-exclamation-circle me-1"></i>Problem Description
                                </h6>
                                <p class="mb-0 text-muted small">
                                    @(problemDesc.Length > 150 ? problemDesc.Substring(0, 150) + "..." : problemDesc)
                                </p>
                            </div>

                            @if (status == "Approved" && quote.ContainsKey("QuotePrice"))
                            {
                                var quotePrice = quote.GetValueOrDefault("QuotePrice");
                                <div class="mb-3">
                                    <div class="alert alert-success mb-0">
                                        <h6 class="alert-heading mb-2">
                                            <i class="bi bi-currency-dollar me-1"></i>Quoted Price
                                        </h6>
                                        <h4 class="mb-0">R @string.Format("{0:N2}", quotePrice)</h4>
                                        @if (quote.ContainsKey("EstimatedDays"))
                                        {
                                            <small class="text-muted">
                                                Estimated completion: @quote["EstimatedDays"] days
                                            </small>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="row text-muted small">
                                <div class="col-6">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    Submitted: @(createdAt?.ToString("dd MMM yyyy") ?? "N/A")
                                </div>
                                @if (updatedAt.HasValue)
                                {
                                    <div class="col-6 text-end">
                                        <i class="bi bi-clock me-1"></i>
                                        Updated: @updatedAt.Value.ToString("dd MMM yyyy")
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            @if (status == "Approved" && !string.IsNullOrEmpty(repairJobId))
                            {
                                <a asp-controller="Customer" 
                                   asp-action="RepairDetails" 
                                   asp-route-id="@repairJobId"
                                   class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-eye me-1"></i>View Repair Job Details
                                </a>
                            }
                            else if (status == "Pending")
                            {
                                <div class="text-center text-muted">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Waiting for technician response
                                </div>
                            }
                            else if (status == "Rejected")
                            {
                                <div class="text-center text-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    This quote request was declined
                                </div>
                            }
                            <div class="text-center mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-hash"></i>Ref: @quoteId.Substring(0, Math.Min(8, quoteId.Length)).ToUpper()
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Customer" asp-action="CustomerGetQuote" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Request Another Quote
            </a>
        </div>
    }
</div>